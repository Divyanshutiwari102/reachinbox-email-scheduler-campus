# Node.js Environment
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# PostgreSQL Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=email_scheduler
POSTGRES_PASSWORD=email_scheduler_pass
POSTGRES_DB=email_scheduler

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# Ethereal Email (for development/testing)
# Leave empty to use auto-generated test account from nodemailer.createTestAccount()
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587

# Worker Configuration
WORKER_CONCURRENCY=3
MIN_DELAY_MS_BETWEEN_SENDS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# Set to true to run the worker inline (for single-process platforms like Render free tier)
RUN_WORKER_INLINE=

# Elasticsearch Connection
ES_HOST=http://localhost:9201

# Slack OAuth (for real-time notifications)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:3000/slack/oauth/callback

# Optional: JWT Secret (if you plan to add authentication later)
# JWT_SECRET=your_super_secret_jwt_key_change_in_production